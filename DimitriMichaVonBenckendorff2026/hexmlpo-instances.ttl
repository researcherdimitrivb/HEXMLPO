 # ExplanationIntention

:DecisionSubjectIntention
    a owl:NamedIndividual , :ExplanationIntention ;
    gufo:inheresIn :DecisionSubjectProfile .

:CalibrateTrust gufo:externallyDependsOn :DecisionSubjectIntention .

:DecisionSupport gufo:externallyDependsOn :DecisionSubjectIntention .

:Contest gufo:externallyDependsOn :DecisionSubjectIntention .

:DomainExpertIntention
    a owl:NamedIndividual , :ExplanationIntention ;
    gufo:inheresIn :DomainExpertProfile .

:DecisionSupport gufo:externallyDependsOn :DomainExpertIntention .

:CalibrateTrust gufo:externallyDependsOn :DomainExpertIntention .

:Justify gufo:externallyDependsOn :DomainExpertIntention .

:TechnicalCreatorIntention
    a owl:NamedIndividual , :ExplanationIntention ;
    gufo:inheresIn :TechnicalCreatorProfile .

:Improve gufo:externallyDependsOn :TechnicalCreatorIntention .

:Audit gufo:externallyDependsOn :TechnicalCreatorIntention .

:Discover gufo:externallyDependsOn :TechnicalCreatorIntention .

:OperationalUserIntention
    a owl:NamedIndividual , :ExplanationIntention ;
    gufo:inheresIn :OperationalUserProfile .

:DecisionSupport gufo:externallyDependsOn :OperationalUserIntention .

:CalibrateTrust gufo:externallyDependsOn :OperationalUserIntention .

:Improve gufo:externallyDependsOn :OperationalUserIntention .

:OrganisationalComplianceOverseerIntention
    a owl:NamedIndividual , :ExplanationIntention ;
    gufo:inheresIn :OrganisationalComplianceOverseerProfile .

:Audit gufo:externallyDependsOn :OrganisationalComplianceOverseerIntention .

:Contest gufo:externallyDependsOn :OrganisationalComplianceOverseerIntention .

:CalibrateTrust gufo:externallyDependsOn :OrganisationalComplianceOverseerIntention .

:ResearcherTheoristIntention
    a owl:NamedIndividual , :ExplanationIntention ;
    gufo:inheresIn :ResearcherTheoristProfile .

:Discover gufo:externallyDependsOn :ResearcherTheoristIntention .

:Improve gufo:externallyDependsOn :ResearcherTheoristIntention .

:Audit gufo:externallyDependsOn :ResearcherTheoristIntention .


