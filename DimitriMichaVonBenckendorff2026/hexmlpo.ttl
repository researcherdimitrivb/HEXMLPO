@prefix : <http://www.w3id.org/HEXMLPO/ontology#> .
@prefix DUL: <http://ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix EPO: <https://raw.githubusercontent.com/tetherless-world/explanation-ontology/refs/heads/master/Ontologies/explanations-pattern-ontology.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix XMLPO: <http://www.w3id.org/xmlpo/ontology#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <http://www.w3id.org/HEXMLPO/ontology#> .

<http://www.w3id.org/HEXMLPO/ontology> rdf:type owl:Ontology ;
                                        owl:versionIRI <http://www.w3id.org/HEXMLPO/ontology/1.0> ;
                                        owl:imports gufo: ,
                                                    <http://www.w3id.org/xmlpo/ontology> ;
                                        dcterms:bibliographicCitation "Benckendorff, D.M. (2026). HEXMLPO: Human-centered Explainability extension for the eXplainable Machine Learning Pipeline Ontology. Master's Thesis, University of Twente."@en ;
                                        dcterms:created "2026-08-31"^^xsd:date ;
                                        dcterms:creator <https://orcid.org/0009-0000-3872-8046> ;
                                        dcterms:description "HEXMLPO extends XMLPO with concepts for stakeholder-centred explainability, accessibility, explanation quality, user capabilities, modalities, goals, intentions, and interaction contexts. The ontology supports the modelling, analysis, and evaluation of human-centred explainable AI systems from the perspective of diverse stakeholders and their explainability needs."@en ;
                                        dcterms:issued "2026-10-22"^^xsd:date ;
                                        dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
                                        dcterms:publisher <https://ror.org/006hf6230> ;
                                        dcterms:source <https://www.w3id.org/xmlpo/ontology> ;
                                        dcterms:title "HEXMLPO: Human-centered Explainability Extension for the eXplainable Machine Learning Pipeline Ontology"@en ;
                                        bibo:status "draft"@en ;
                                        vann:preferredNamespacePrefix "hexmlpo" ;
                                        vann:preferredNamespaceUri "http://www.w3id.org/HEXMLPO/ontology#" ;
                                        owl:versionInfo "1.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/creator
dcterms:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/issued
dcterms:issued rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/publisher
dcterms:publisher rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/source
dcterms:source rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty .


###  http://purl.org/ontology/bibo/status
bibo:status rdf:type owl:AnnotationProperty .


###  http://www.w3id.org/HEXMLPO/ontology#isAbout
:isAbout rdf:type owl:AnnotationProperty ;
         rdfs:subPropertyOf :isAbout_1 .


###  http://www.w3id.org/HEXMLPO/ontology#isAbout_1
:isAbout_1 rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.w3id.org/HEXMLPO/ontology#applicableTo
:applicableTo rdf:type owl:ObjectProperty ;
              rdfs:domain :ExplanationEvaluationMetric ;
              rdfs:range :ExplanationQuality ;
              rdfs:comment "Relates an explanation evaluation metric to the explanation quality criterion that it can be used to assess."@en ;
              rdfs:label "applicableTo"@en .


###  http://www.w3id.org/HEXMLPO/ontology#canProcess
:canProcess rdf:type owl:ObjectProperty ;
            rdfs:domain :XAIStakeholder ;
            rdfs:range XMLPO:ExplanationModality .


###  http://www.w3id.org/HEXMLPO/ontology#concernsExplanationType
:concernsExplanationType rdf:type owl:ObjectProperty ;
            rdfs:domain [
				rdf:type owl:Class ;
				owl:unionOf (
					:ExplanationTypePriority
					:TypeGoalAlignment
				)
		   ] ;
           rdfs:range :ExplanationType ;
           rdfs:comment "Relates an explanation type priority relator to a higher-order explanation type."@en ;
           rdfs:label "concernsExplanationType"@en .


###  http://www.w3id.org/HEXMLPO/ontology#contributesTo
:contributesTo rdf:type owl:ObjectProperty ;
               rdfs:domain :ExplanationEvaluationMetric ;
               rdfs:range :Desideratum .


###  http://www.w3id.org/HEXMLPO/ontology#evaluatesWithRespectTo
:evaluatesWithRespectTo rdf:type owl:ObjectProperty ;
                        rdfs:domain :ExplanationEvaluationPerspective ;
                        rdfs:range :ExplanationQuality ;
                        rdfs:comment "Relates an explanation evaluation perspective to an explanation quality criterion that is considered under that perspective when evaluating an explanation artifact."@en ;
                        rdfs:label "evaluatesWithRespectTo"@en .


###  http://www.w3id.org/HEXMLPO/ontology#evaluationContext
:evaluationContext rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf gufo:hasReifiedQualityValue ;
                   rdfs:domain :ExplanationEvaluationMetric ;
                   rdfs:range :ContextualityLevel ;
                   rdfs:comment "Relates an explanation evaluation metric to the contextuality level at which that metric assesses an explanation."@en ;
                   rdfs:label "evaluationContext"@en .


###  http://www.w3id.org/HEXMLPO/ontology#expresses
:expresses rdf:type owl:ObjectProperty ;
           rdfs:domain EPO:Explanation ;
           rdfs:range XMLPO:ExplanationArtifact ;
           rdfs:comment "Relates an explanation to the explanation artifact through which that explanation is expressed or communicated."@en ;
           rdfs:label "expresses"@en .


###  http://www.w3id.org/HEXMLPO/ontology#format
:format rdf:type owl:ObjectProperty ;
        rdfs:subPropertyOf gufo:hasReifiedQualityValue ;
        rdfs:domain XMLPO:ExplanationModality ;
        rdfs:range :RepresentationFormat ;
        rdfs:comment "Relates an explanation modality to the representation format, such as textual, visual, numerical, or example-based, in which explanations of that modality are presented."@en ;
        rdfs:label "format"@en .


###  http://www.w3id.org/HEXMLPO/ontology#level
:level rdf:type owl:ObjectProperty ;
       rdfs:subPropertyOf gufo:hasReifiedQualityValue ;
       rdfs:domain :Knowledge ;
       rdfs:range :KnowledgeLevel ;
       rdfs:comment "Relates knowledge held by a stakeholder to the level, on an ordinal scale from none to expert, at which it is held."@en ;
       rdfs:label "level"@en .


###  http://www.w3id.org/HEXMLPO/ontology#preferredExplanationGoalOf
:preferredExplanationGoalOf rdf:type owl:ObjectProperty ;
                            rdfs:domain :XAIStakeholder ;
                            rdfs:range :ExplanationGoal .


###  http://www.w3id.org/HEXMLPO/ontology#preferredExplanationModalityOf
:preferredExplanationModalityOf rdf:type owl:ObjectProperty ;
                                rdfs:domain :XAIStakeholder ;
                                rdfs:range XMLPO:ExplanationModality .


###  http://www.w3id.org/HEXMLPO/ontology#preferredExplanationQualityOf
:preferredExplanationQualityOf rdf:type owl:ObjectProperty ;
                               rdfs:domain :ExplanationQuality ;
                               rdfs:range :XAIStakeholder .


###  http://www.w3id.org/HEXMLPO/ontology#preferredExplanationTypeOf
:preferredExplanationTypeOf rdf:type owl:ObjectProperty ;
                            rdfs:domain :XAIStakeholder ;
                            rdfs:range :ExplanationType .


###  http://www.w3id.org/HEXMLPO/ontology#producing
:producing rdf:type owl:ObjectProperty ;
           rdfs:domain :ExplanationEvaluationExecution ;
           rdfs:range :ExplanationQualityMeasurement ;
           rdfs:comment "Relates an explanation evaluation execution to the explanation quality measurement that it produces."@en ;
           rdfs:label "producing"@en .


###  http://www.w3id.org/HEXMLPO/ontology#status
:status rdf:type owl:ObjectProperty ;
        rdfs:subPropertyOf gufo:hasReifiedQualityValue ;
        rdfs:domain :SensoryAbility ;
        rdfs:range :FunctionalStatus ;
        rdfs:comment "Relates a sensory ability to its functional status, indicating whether the ability is non-functional, impaired, or fully functional."@en ;
        rdfs:label "status"@en .


###  http://www.w3id.org/HEXMLPO/ontology#supportsAchievementOf
:supportsAchievementOf rdf:type owl:ObjectProperty ;
                       rdfs:domain :ExplanationType ;
                       rdfs:range :ExplanationGoal .


###  http://www.w3id.org/HEXMLPO/ontology#usesMetric
:usesMetric rdf:type owl:ObjectProperty ;
            rdfs:domain :ExplanationEvaluationExecution ;
            rdfs:range :ExplanationEvaluationMetric ;
            rdfs:comment "Relates an explanation evaluation execution to the explanation evaluation metric that it applies."@en ;
            rdfs:label "usesMetric"@en .


###  https://raw.githubusercontent.com/tetherless-world/explanation-ontology/refs/heads/master/Ontologies/explanations-pattern-ontology.owl#explanationHasExplanationEvaluationExecution
EPO:explanationHasExplanationEvaluationExecution rdf:type owl:ObjectProperty ;
                                                 rdfs:domain EPO:Explanation ;
                                                 rdfs:range :ExplanationEvaluationExecution ;
                                                 rdfs:comment "Relates an explanation to an explanation evaluation execution in which its quality is assessed."@en .


###  https://raw.githubusercontent.com/tetherless-world/explanation-ontology/refs/heads/master/Ontologies/explanations-pattern-ontology.owl#isConceptualizedBy
EPO:isConceptualizedBy rdf:type owl:ObjectProperty ;
                       rdfs:domain EPO:Explanation ;
                       rdfs:range DUL:Agent ;
                       rdfs:comment "Relates an explanation to the agent that conceptualises it."@en ;
                       rdfs:label "isConceptualizedBy"@en .


#################################################################
#    Data properties
#################################################################

###  http://www.w3id.org/HEXMLPO/ontology#desideratumName
:desideratumName rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf gufo:hasQualityValue ;
                 rdfs:domain :Desideratum ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Specifies the name by which a desideratum is identified."@en ;
                 rdfs:label "desideratumName"@en .


###  http://www.w3id.org/HEXMLPO/ontology#dimension
:dimension rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf gufo:hasQualityValue ;
           rdfs:domain :Desideratum ;
           rdfs:comment "Specifies the dimension under which a desideratum is characterised."@en ;
           rdfs:label "dimension"@en .


###  http://www.w3id.org/HEXMLPO/ontology#evidenceSource
:evidenceSource rdf:type owl:DatatypeProperty ;
                rdfs:subPropertyOf gufo:hasQualityValue ;
                rdfs:domain :GoalTypeAlignment ;
                rdfs:range xsd:string ;
                rdfs:comment "Specifies the source of the evidence supporting the alignment between an explanation type and an explanation goal."@en ;
                rdfs:label "evidenceSource"@en .


###  http://www.w3id.org/HEXMLPO/ontology#goalRank
:goalRank rdf:type owl:DatatypeProperty ;
        rdfs:subPropertyOf gufo:hasQualityValue ;
        rdfs:domain :ExplanationGoalPriority ;
        rdfs:comment "Specifies the position of an explanation goal in the ordering of priorities assigned by a stakeholder."@en ;
        rdfs:label "goalRank"@en .


###  http://www.w3id.org/HEXMLPO/ontology#typeRank
:typeRank rdf:type owl:DatatypeProperty ;
        rdfs:subPropertyOf gufo:hasQualityValue ;
        rdfs:domain :ExplanationTypePriority ;
        rdfs:comment "Specifies the position of an explanation type in the ordering of priorities assigned by a stakeholder."@en ;
        rdfs:label "typeRank"@en .


###  http://www.w3id.org/HEXMLPO/ontology#qualityRank
:qualityRank rdf:type owl:DatatypeProperty ;
      rdfs:subPropertyOf gufo:hasQualityValue ;
      rdfs:domain :ExplanationQualityPriority ;
      rdfs:comment "Specifies the position of an explanation quality criterion in the ordering of priorities assigned by a stakeholder."@en ;
      rdfs:label "qualityRank"@en .


#################################################################
#    Classes
#################################################################

###  http://ontologydesignpatterns.org/ont/dul/DUL.owl#Agent
DUL:Agent rdf:type owl:Class ;
          rdfs:subClassOf gufo:FunctionalComplex .


###  http://ontologydesignpatterns.org/ont/dul/DUL.owl#Theory
DUL:Theory rdf:type owl:Class ;
           rdfs:subClassOf gufo:FunctionalComplex .


###  http://www.w3id.org/HEXMLPO/ontology#AuditoryAcuity
:AuditoryAcuity rdf:type owl:Class ;
                rdfs:subClassOf :SensoryAbility .


###  http://www.w3id.org/HEXMLPO/ontology#CaseBasedExplanation
:CaseBasedExplanation rdf:type owl:Class ;
                      rdfs:subClassOf EPO:Explanation .


###  http://www.w3id.org/HEXMLPO/ontology#Coherence
:Coherence rdf:type owl:Class ;
           rdfs:subClassOf :UserDimension .


###  http://www.w3id.org/HEXMLPO/ontology#Compactness
:Compactness rdf:type owl:Class ;
             rdfs:subClassOf :PresentationDimension .


###  http://www.w3id.org/HEXMLPO/ontology#Completeness
:Completeness rdf:type owl:Class ;
              rdfs:subClassOf :ContentDimension .


###  http://www.w3id.org/HEXMLPO/ontology#Composition
:Composition rdf:type owl:Class ;
             rdfs:subClassOf :PresentationDimension .


###  http://www.w3id.org/HEXMLPO/ontology#ComprehensibilityPerspective
:ComprehensibilityPerspective rdf:type owl:Class ;
                              rdfs:subClassOf :ExplanationEvaluationPerspective .


###  http://www.w3id.org/HEXMLPO/ontology#Confidence
:Confidence rdf:type owl:Class ;
            rdfs:subClassOf :PresentationDimension .


###  http://www.w3id.org/HEXMLPO/ontology#Consistency
:Consistency rdf:type owl:Class ;
             rdfs:subClassOf :ContentDimension .


###  http://www.w3id.org/HEXMLPO/ontology#ContentDimension
:ContentDimension rdf:type owl:Class ;
                  rdfs:subClassOf :ExplanationQuality .


###  http://www.w3id.org/HEXMLPO/ontology#Context
:Context rdf:type owl:Class ;
         rdfs:subClassOf :UserDimension .


###  http://www.w3id.org/HEXMLPO/ontology#ContextualExplanation
:ContextualExplanation rdf:type owl:Class ;
                       rdfs:subClassOf EPO:Explanation .


###  http://www.w3id.org/HEXMLPO/ontology#ContextualityLevel
:ContextualityLevel rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Class ;
                                          owl:oneOf ( :IExplanansCentric
                                                      :IIIInputIntervention
                                                      :IIModelObservation
                                                      :IVModelIntervention
                                                      :VAPrioriConstrained
                                                    )
                                        ] ;
                    rdfs:subClassOf gufo:QualityValue .


###  http://www.w3id.org/HEXMLPO/ontology#Continuity
:Continuity rdf:type owl:Class ;
            rdfs:subClassOf :ContentDimension .


###  http://www.w3id.org/HEXMLPO/ontology#ContrastiveExplanation
:ContrastiveExplanation rdf:type owl:Class ;
                        rdfs:subClassOf EPO:Explanation .


###  http://www.w3id.org/HEXMLPO/ontology#Contrastivity
:Contrastivity rdf:type owl:Class ;
               rdfs:subClassOf :ContentDimension .


###  http://www.w3id.org/HEXMLPO/ontology#Controllability
:Controllability rdf:type owl:Class ;
                 rdfs:subClassOf :UserDimension .


###  http://www.w3id.org/HEXMLPO/ontology#Correctness
:Correctness rdf:type owl:Class ;
             rdfs:subClassOf :ContentDimension .


###  http://www.w3id.org/HEXMLPO/ontology#CounterfactualExplanation
:CounterfactualExplanation rdf:type owl:Class ;
                           rdfs:subClassOf EPO:Explanation .


###  http://www.w3id.org/HEXMLPO/ontology#CovariateComplexity
:CovariateComplexity rdf:type owl:Class ;
                     rdfs:subClassOf :ContentDimension .


###  http://www.w3id.org/HEXMLPO/ontology#DataExplanation
:DataExplanation rdf:type owl:Class ;
                 rdfs:subClassOf EPO:Explanation .


###  http://www.w3id.org/HEXMLPO/ontology#DecisionSubject
:DecisionSubject rdf:type owl:Class ;
                 rdfs:subClassOf :XAIStakeholder .


###  http://www.w3id.org/HEXMLPO/ontology#Desideratum
:Desideratum rdf:type owl:Class ;
             rdfs:subClassOf gufo:FunctionalComplex .


###  http://www.w3id.org/HEXMLPO/ontology#DesideratumName
:DesideratumName rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Class ;
                                       owl:oneOf ( :Interpretability
                                                   :Technical
                                                 )
                                     ] ;
                 rdfs:subClassOf gufo:QualityValue .


###  http://www.w3id.org/HEXMLPO/ontology#Domain
:Domain rdf:type owl:Class ;
        rdfs:subClassOf gufo:FunctionalComplex ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty gufo:inheresIn ;
                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :DomainKnowledge
                        ] .


###  http://www.w3id.org/HEXMLPO/ontology#DomainExpert
:DomainExpert rdf:type owl:Class ;
              rdfs:subClassOf :XAIStakeholder .


###  http://www.w3id.org/HEXMLPO/ontology#DomainKnowledge
:DomainKnowledge rdf:type owl:Class ;
                 rdfs:subClassOf :Knowledge .


###  http://www.w3id.org/HEXMLPO/ontology#EverydayExplanation
:EverydayExplanation rdf:type owl:Class ;
                     rdfs:subClassOf EPO:Explanation .


###  http://www.w3id.org/HEXMLPO/ontology#ExplanationEvaluationExecution
:ExplanationEvaluationExecution rdf:type owl:Class ;
                                rdfs:subClassOf gufo:Event .


###  http://www.w3id.org/HEXMLPO/ontology#ExplanationEvaluationMetric
:ExplanationEvaluationMetric rdf:type owl:Class ;
                             rdfs:subClassOf gufo:FunctionalComplex .


###  http://www.w3id.org/HEXMLPO/ontology#ExplanationEvaluationPerspective
:ExplanationEvaluationPerspective rdf:type owl:Class ;
                                  rdfs:subClassOf gufo:IntrinsicMode ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty gufo:inheresIn ;
                                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                    owl:onClass :XAIStakeholder
                                                  ] .


###  http://www.w3id.org/HEXMLPO/ontology#ExplanationGoal
:ExplanationGoal rdf:type owl:Class ;
                 rdfs:subClassOf gufo:IntrinsicMode ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty gufo:externallyDependsOn ;
                                   owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass :ExplanationIntention
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty [ owl:inverseOf gufo:inheresIn
                                                  ] ;
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass :XAIStakeholder
                                 ] .


###  http://www.w3id.org/HEXMLPO/ontology#ExplanationGoalPriority
:ExplanationGoalPriority rdf:type owl:Class ;
                         rdfs:subClassOf gufo:Relator ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty gufo:mediates ;
                                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass :ExplanationGoal
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty gufo:mediates ;
                                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass :XAIStakeholder
                                         ] .


###  http://www.w3id.org/HEXMLPO/ontology#ExplanationIntention
:ExplanationIntention rdf:type owl:Class ;
                      rdfs:subClassOf gufo:IntrinsicMode ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty [ owl:inverseOf gufo:externallyDependsOn
                                                       ] ;
                                        owl:someValuesFrom :ExplanationGoal
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty gufo:inheresIn ;
                                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass :XAIStakeholder
                                      ] .


###  http://www.w3id.org/HEXMLPO/ontology#ExplanationModalityPreference
:ExplanationModalityPreference rdf:type owl:Class ;
                               rdfs:subClassOf gufo:Relator ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty gufo:mediates ;
                                                 owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass :XAIStakeholder
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty gufo:mediates ;
                                                 owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass XMLPO:ExplanationModality
                                               ] .


###  http://www.w3id.org/HEXMLPO/ontology#ExplanationQuality
:ExplanationQuality rdf:type owl:Class ;
                    rdfs:subClassOf gufo:Quality .


###  http://www.w3id.org/HEXMLPO/ontology#ExplanationQualityMeasurement
:ExplanationQualityMeasurement rdf:type owl:Class ;
                               rdfs:subClassOf gufo:Quality ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty gufo:inheresIn ;
                                                 owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass EPO:Explanation
                                               ] .


###  http://www.w3id.org/HEXMLPO/ontology#ExplanationQualityPriority
:ExplanationQualityPriority rdf:type owl:Class ;
                            rdfs:subClassOf gufo:Relator ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty gufo:mediates ;
                                              owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass :ExplanationQuality
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty gufo:mediates ;
                                              owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass :XAIStakeholder
                                            ] .


###  http://www.w3id.org/HEXMLPO/ontology#ExplanationType
:ExplanationType rdf:type owl:Class ;
                 rdfs:subClassOf gufo:ConcreteIndividualType .


###  http://www.w3id.org/HEXMLPO/ontology#ExplanationTypePriority
:ExplanationTypePriority rdf:type owl:Class ;
                         rdfs:subClassOf gufo:Relator ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty gufo:mediates ;
                                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass :XAIStakeholder
                                         ] .


###  http://www.w3id.org/HEXMLPO/ontology#FairnessExplanation
:FairnessExplanation rdf:type owl:Class ;
                     rdfs:subClassOf EPO:Explanation .


###  http://www.w3id.org/HEXMLPO/ontology#FidelityPerspective
:FidelityPerspective rdf:type owl:Class ;
                     rdfs:subClassOf :ExplanationEvaluationPerspective .


###  http://www.w3id.org/HEXMLPO/ontology#FunctionalStatus
:FunctionalStatus rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Class ;
                                        owl:oneOf ( :FullyFunctional
                                                    :Impaired
                                                    :NonFunctional
                                                  )
                                      ] ;
                  rdfs:subClassOf gufo:QualityValue .


###  http://www.w3id.org/HEXMLPO/ontology#GoalTypeAlignment
:GoalTypeAlignment rdf:type owl:Class ;
                   rdfs:subClassOf gufo:Relator ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty gufo:mediates ;
                                     owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass :ExplanationGoal
                                   ] .


###  http://www.w3id.org/HEXMLPO/ontology#ImpactExplanation
:ImpactExplanation rdf:type owl:Class ;
                   rdfs:subClassOf EPO:Explanation .


###  http://www.w3id.org/HEXMLPO/ontology#Knowledge
:Knowledge rdf:type owl:Class ;
           rdfs:subClassOf gufo:IntrinsicMode ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty gufo:inheresIn ;
                             owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :Person
                           ] .


###  http://www.w3id.org/HEXMLPO/ontology#KnowledgeLevel
:KnowledgeLevel rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Class ;
                                      owl:oneOf ( :Advanced
                                                  :Basic
                                                  :Expert
                                                  :Intermediate
                                                  :None
                                                )
                                    ] ;
                rdfs:subClassOf gufo:QualityValue .


###  http://www.w3id.org/HEXMLPO/ontology#MLDomain
:MLDomain rdf:type owl:Class ;
          rdfs:subClassOf :Domain ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty gufo:inheresIn ;
                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass :TechnicalKnowledge
                          ] .


###  http://www.w3id.org/HEXMLPO/ontology#ModalityAccess
:ModalityAccess rdf:type owl:Class ;
                rdfs:subClassOf gufo:Relator ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty gufo:mediates ;
                                  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass :XAIStakeholder
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty gufo:mediates ;
                                  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass XMLPO:ExplanationModality
                                ] .


###  http://www.w3id.org/HEXMLPO/ontology#OperationalUser
:OperationalUser rdf:type owl:Class ;
                 rdfs:subClassOf :XAIStakeholder .


###  http://www.w3id.org/HEXMLPO/ontology#OrganisationalComplianceOverseer
:OrganisationalComplianceOverseer rdf:type owl:Class ;
                                  rdfs:subClassOf :XAIStakeholder .


###  http://www.w3id.org/HEXMLPO/ontology#Person
:Person rdf:type owl:Class ;
        rdfs:subClassOf gufo:FunctionalComplex ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty gufo:inheresIn ;
                          owl:someValuesFrom :SensoryAbility
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty [ owl:inverseOf gufo:inheresIn
                                         ] ;
                          owl:someValuesFrom :Knowledge
                        ] .


###  http://www.w3id.org/HEXMLPO/ontology#PresentationDimension
:PresentationDimension rdf:type owl:Class ;
                       rdfs:subClassOf :ExplanationQuality .


###  http://www.w3id.org/HEXMLPO/ontology#RationaleExplanation
:RationaleExplanation rdf:type owl:Class ;
                      rdfs:subClassOf EPO:Explanation .


###  http://www.w3id.org/HEXMLPO/ontology#RepresentationFormat
:RepresentationFormat rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Class ;
                                            owl:oneOf ( :Example
                                                        :Numerical
                                                        :Textual
                                                        :Visual
                                                      )
                                          ] ;
                      rdfs:subClassOf gufo:QualityValue .


###  http://www.w3id.org/HEXMLPO/ontology#ResearcherTheorist
:ResearcherTheorist rdf:type owl:Class ;
                    rdfs:subClassOf :XAIStakeholder .


###  http://www.w3id.org/HEXMLPO/ontology#ResponsibilityExplanation
:ResponsibilityExplanation rdf:type owl:Class ;
                           rdfs:subClassOf EPO:Explanation .


###  http://www.w3id.org/HEXMLPO/ontology#SafetyAndPerformanceExplanation
:SafetyAndPerformanceExplanation rdf:type owl:Class ;
                                 rdfs:subClassOf EPO:Explanation .


###  http://www.w3id.org/HEXMLPO/ontology#ScientificExplanation
:ScientificExplanation rdf:type owl:Class ;
                       rdfs:subClassOf EPO:Explanation .


###  http://www.w3id.org/HEXMLPO/ontology#SensoryAbility
:SensoryAbility rdf:type owl:Class ;
                rdfs:subClassOf gufo:IntrinsicMode ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty [ owl:inverseOf gufo:inheresIn
                                                 ] ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass :Person
                                ] .


###  http://www.w3id.org/HEXMLPO/ontology#SimulationBasedExplanation
:SimulationBasedExplanation rdf:type owl:Class ;
                            rdfs:subClassOf EPO:Explanation .


###  http://www.w3id.org/HEXMLPO/ontology#StatisticalExplanation
:StatisticalExplanation rdf:type owl:Class ;
                        rdfs:subClassOf EPO:Explanation .


###  http://www.w3id.org/HEXMLPO/ontology#TechnicalCreator
:TechnicalCreator rdf:type owl:Class ;
                  rdfs:subClassOf :XAIStakeholder .


###  http://www.w3id.org/HEXMLPO/ontology#TechnicalKnowledge
:TechnicalKnowledge rdf:type owl:Class ;
                    rdfs:subClassOf :Knowledge .


###  http://www.w3id.org/HEXMLPO/ontology#TraceBasedExplanation
:TraceBasedExplanation rdf:type owl:Class ;
                       rdfs:subClassOf EPO:Explanation .


###  http://www.w3id.org/HEXMLPO/ontology#UserDimension
:UserDimension rdf:type owl:Class ;
               rdfs:subClassOf :ExplanationQuality .


###  http://www.w3id.org/HEXMLPO/ontology#VisualAcuity
:VisualAcuity rdf:type owl:Class ;
              rdfs:subClassOf :SensoryAbility .


###  http://www.w3id.org/HEXMLPO/ontology#XAIStakeholder
:XAIStakeholder rdf:type owl:Class ;
                rdfs:subClassOf :Person ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty [ owl:inverseOf gufo:mediates
                                                 ] ;
                                  owl:someValuesFrom :ModalityAccess
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty [ owl:inverseOf gufo:participatedIn
                                                 ] ;
                                  owl:someValuesFrom XMLPO:ExplanationEvaluation
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty gufo:inheresIn ;
                                  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass :ExplanationGoal
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :preferredExplanationGoalOf ;
                                  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass :ExplanationGoal
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty [ owl:inverseOf gufo:inheresIn
                                                 ] ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass :ExplanationEvaluationPerspective
                                ] .


###  http://www.w3id.org/xmlpo/ontology#ExplanationArtifact
XMLPO:ExplanationArtifact rdf:type owl:Class ;
                          rdfs:subClassOf gufo:FunctionalComplex ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty gufo:inheresIn ;
                                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass :ExplanationQuality
                                          ] .


###  http://www.w3id.org/xmlpo/ontology#ExplanationEvaluation
XMLPO:ExplanationEvaluation rdf:type owl:Class ;
                            rdfs:subClassOf gufo:Event ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty [ owl:inverseOf gufo:participatedIn
                                                             ] ;
                                              owl:someValuesFrom :ExplanationQuality
                                            ] .


###  http://www.w3id.org/xmlpo/ontology#ExplanationModality
XMLPO:ExplanationModality rdf:type owl:Class ;
                          rdfs:subClassOf gufo:Quality .


###  https://raw.githubusercontent.com/tetherless-world/explanation-ontology/refs/heads/master/Ontologies/explanations-pattern-ontology.owl#Condition
EPO:Condition rdf:type owl:Class ;
              rdfs:subClassOf gufo:Situation .


###  https://raw.githubusercontent.com/tetherless-world/explanation-ontology/refs/heads/master/Ontologies/explanations-pattern-ontology.owl#Explanandum
EPO:Explanandum rdf:type owl:Class ;
                rdfs:subClassOf gufo:Event ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty [ owl:inverseOf gufo:mediates
                                                 ] ;
                                  owl:someValuesFrom EPO:Explanation
                                ] .


###  https://raw.githubusercontent.com/tetherless-world/explanation-ontology/refs/heads/master/Ontologies/explanations-pattern-ontology.owl#Explanans
EPO:Explanans rdf:type owl:Class ;
              rdfs:subClassOf gufo:Event ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty [ owl:inverseOf gufo:mediates
                                               ] ;
                                owl:someValuesFrom EPO:Explanation
                              ] .


###  https://raw.githubusercontent.com/tetherless-world/explanation-ontology/refs/heads/master/Ontologies/explanations-pattern-ontology.owl#Explanation
EPO:Explanation rdf:type owl:Class ;
                rdfs:subClassOf gufo:Relator ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty gufo:mediates ;
                                  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass DUL:Theory
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty gufo:mediates ;
                                  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass EPO:Condition
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty gufo:mediates ;
                                  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass EPO:Explanandum
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty gufo:mediates ;
                                  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass EPO:Explanans
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty [ owl:inverseOf gufo:inheresIn
                                                 ] ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass :ExplanationQualityMeasurement
                                ] .


