EPO:Explanation rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty [ owl:inverseOf gufo:inheresIn ];
  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :ExplanationQualityMeasurement
].
:ExplanationQualityMeasurement rdfs:subClassOf [
  rdf:type owl:Restriction;
