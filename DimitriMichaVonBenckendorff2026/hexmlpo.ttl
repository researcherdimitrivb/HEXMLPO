###  http://www.w3id.org/HEXMLPO/ontology#supportsAchievementOf
:supportsAchievementOf rdf:type owl:NamedIndividual ,
                                gufo:MaterialRelationshipType .


###  https://raw.githubusercontent.com/tetherless-world/explanation-ontology/refs/heads/master/Ontologies/explanations-pattern-ontology.owl#Condition
EPO:Condition rdf:type owl:NamedIndividual ,
                       gufo:SituationType .


###  https://raw.githubusercontent.com/tetherless-world/explanation-ontology/refs/heads/master/Ontologies/explanations-pattern-ontology.owl#Explanandum
EPO:Explanandum rdf:type owl:NamedIndividual ,
                         gufo:EventType .


###  https://raw.githubusercontent.com/tetherless-world/explanation-ontology/refs/heads/master/Ontologies/explanations-pattern-ontology.owl#Explanans
EPO:Explanans rdf:type owl:NamedIndividual ,
                       gufo:EventType .


###  https://raw.githubusercontent.com/tetherless-world/explanation-ontology/refs/heads/master/Ontologies/explanations-pattern-ontology.owl#Explanation
EPO:Explanation rdf:type owl:NamedIndividual ,
                         gufo:Kind .


#################################################################
#    Annotations
#################################################################

DUL:Agent rdfs:comment "An entity, physical or social, that can act intentionally and that conceptualises an explanation."@en ;
          rdfs:label "Agent"@en .


DUL:Theory rdfs:comment "A set of general assumptions or principles used to describe or account for phenomena, on which an explanation relies."@en ;
           rdfs:label "Theory"@en .


:AuditoryAcuity rdfs:comment "A sensory ability concerning the sharpness and clarity of a person's hearing."@en ;
                rdfs:label "AuditoryAcuity"@en .


:CaseBasedExplanation rdfs:comment "An explanation that supports a conclusion by presenting actual prior cases that are similar to the one being explained."@en ;
                      rdfs:label "CaseBasedExplanation"@en .


:Coherence rdfs:comment "The degree to which explanatory elements form a logically understandable whole."@en ;
           rdfs:label "Coherence"@en .


:Compactness rdfs:comment "The degree to which an explanation conveys information concisely."@en ;
             rdfs:label "Compactness"@en .


:Completeness rdfs:comment "The degree to which an explanation contains all information required for its intended purpose."@en ;
              rdfs:label "Completeness"@en .


:Composition rdfs:comment "The degree to which explanatory information is organised and structured effectively."@en ;
             rdfs:label "Composition"@en .


:ComprehensibilityPerspective rdfs:comment "An assessment perspective focusing on the understandability of explanations by stakeholders."@en ;
                              rdfs:label "ComprehensibilityPerspective"@en .


:Confidence rdfs:comment "The degree to which an explanation conveys certainty or evidential strength."@en ;
            rdfs:label "Confidence"@en .


:Consistency rdfs:comment "The degree to which similar situations yield coherent and non-contradictory explanations."@en ;
             rdfs:label "Consistency"@en .


:ContentDimension rdfs:comment "The explanation quality dimension concerning the informational content of explanations."@en ;
                  rdfs:label "ContentDimension"@en .


:Context rdfs:comment "The degree to which an explanation incorporates relevant situational information."@en ;
         rdfs:label "Context"@en .


:ContextualExplanation rdfs:comment "An explanation that draws on information beyond the explicit inputs and outputs, such as the user, the situation, and the wider environment."@en ;
                       rdfs:label "ContextualExplanation"@en .


:ContextualityLevel rdfs:comment "An ordinal scale characterising the context in which an evaluation metric assesses an explanation: explanans-centric, model observation, input intervention, model intervention, or a priori constrained."@en ;
                    rdfs:label "ContextualityLevel"@en .


:Continuity rdfs:comment "The degree to which small changes in inputs produce proportionate changes in explanations."@en ;
            rdfs:label "Continuity"@en .


:ContrastiveExplanation rdfs:comment "An explanation that accounts for why one outcome occurred instead of a specific alternative outcome."@en ;
                        rdfs:label "ContrastiveExplanation"@en .


:Contrastivity rdfs:comment "The degree to which an explanation highlights why one outcome occurred instead of an alternative."@en ;
               rdfs:label "Contrastivity"@en .


:Controllability rdfs:comment "The degree to which stakeholders can influence, explore, or manipulate the explanation process."@en ;
                 rdfs:label "Controllability"@en .


:Correctness rdfs:comment "The degree to which an explanation accurately reflects the underlying system behaviour."@en ;
             rdfs:label "Correctness"@en .


:CounterfactualExplanation rdfs:comment "An explanation describing which outcome would have resulted had the inputs been different."@en ;
                           rdfs:label "CounterfactualExplanation"@en .


:CovariateComplexity rdfs:comment "The degree of complexity associated with the variables, features, or factors used in an explanation."@en ;
                     rdfs:label "CovariateComplexity"@en .


:DataExplanation rdfs:comment "An explanation describing which data were used to train, test, and reach a decision in an AI system, and how they were used."@en ;
                 rdfs:label "DataExplanation"@en .


:DecisionSubject rdfs:comment "A stakeholder who is directly affected by a decision or prediction produced by an ML model."@en ;
                 rdfs:label "DecisionSubject"@en .


:Desideratum rdfs:comment "A property that explanations are desired to satisfy, classified as interpretability or technical, and to which evaluation metrics contribute."@en ;
             rdfs:label "Desideratum"@en .


:DesideratumName rdfs:comment "An enumeration of the names under which desiderata are classified: interpretability and technical."@en ;
                 rdfs:label "DesideratumName"@en .


:Domain rdfs:comment "An area of application or subject matter about which a person can hold knowledge."@en ;
        rdfs:label "Domain"@en .


:DomainExpert rdfs:comment "A stakeholder possessing expertise about the application domain in which the AI system operates."@en ;
              rdfs:label "DomainExpert"@en .


:DomainKnowledge rdfs:comment "Knowledge concerning the application domain in which the AI system is deployed."@en ;
                 rdfs:label "DomainKnowledge"@en .


:EverydayExplanation rdfs:comment "An explanation that accounts for an outcome through familiar real-world accounts that appeal to the stakeholder's general knowledge and understanding."@en ;
                     rdfs:label "EverydayExplanation"@en .


:ExplanationEvaluationExecution rdfs:comment "An event in which an explanation evaluation metric is applied to an explanation, producing an explanation quality measurement."@en ;
                                rdfs:label "ExplanationEvaluationExecution"@en .


:ExplanationEvaluationMetric rdfs:comment "A measure for assessing an explanation quality, which contributes to a desideratum and is evaluated at a given level of contextuality."@en ;
                             rdfs:label "ExplanationEvaluationMetric"@en .


:ExplanationEvaluationPerspective rdfs:comment "A perspective from which explanation quality is evaluated."@en ;
                                  rdfs:label "ExplanationEvaluationPerspective"@en .


:ExplanationGoal rdfs:comment "A stakeholder objective that motivates the need for an explanation."@en ;
                 rdfs:label "ExplanationGoal"@en .


:ExplanationGoalPriority rdfs:comment "A relator representing the priority assigned by a stakeholder to a particular explanation goal."@en ;
                         rdfs:label "ExplanationGoalPriority"@en .


:ExplanationIntention rdfs:comment "A stakeholder-specific disposition that gives rise to one or more explanation goals."@en ;
                      rdfs:label "ExplanationIntention"@en .


:ExplanationModalityPreference rdfs:comment "A relator representing the priority assigned by a stakeholder to a particular explanation modality."@en ;
                               rdfs:label "ExplanationModalityPreference"@en .


:ExplanationQuality rdfs:comment "A quality attribute used to assess the effectiveness or suitability of an explanation artifact."@en ;
                    rdfs:label "ExplanationQuality"@en .


:ExplanationQualityMeasurement rdfs:comment "A quality of an explanation that records the outcome of measuring it with an explanation evaluation metric."@en ;
                               rdfs:label "ExplanationQualityMeasurement"@en .


:ExplanationQualityPriority rdfs:comment "A relator representing the priority assigned by a stakeholder to a particular explanation quality criterion."@en ;
                            rdfs:label "ExplanationQualityPriority"@en .


:ExplanationType rdfs:comment "A category of explanation that characterises the form or reasoning pattern expressed by an explanation artifact."@en ;
                 rdfs:label "ExplanationType"@en .


:ExplanationTypePriority rdfs:comment "A relator representing the priority assigned by a stakeholder to a particular explanation type."@en ;
                         rdfs:label "ExplanationTypePriority"@en .


:FairnessExplanation rdfs:comment "An explanation describing the steps taken to ensure that an AI-supported decision is unbiased and treats individuals equitably."@en ;
                     rdfs:label "FairnessExplanation"@en .


:FidelityPerspective rdfs:comment "An assessment perspective focusing on the faithfulness of explanations to the underlying model."@en ;
                     rdfs:label "FidelityPerspective"@en .


:FunctionalStatus rdfs:comment "An enumeration of the degrees to which a sensory ability functions: non-functional, impaired, or fully functional."@en ;
                  rdfs:label "FunctionalStatus"@en .


:GoalTypeAlignment rdfs:comment "A relator expressing that a particular explanation type is suitable for achieving a particular explanation goal."@en ;
                   rdfs:label "GoalTypeAlignment"@en .


:ImpactExplanation rdfs:comment "An explanation describing the effects that the use of an AI system and its decisions has, or may have, on individuals and on society."@en ;
                   rdfs:label "ImpactExplanation"@en .


:Knowledge rdfs:comment "Knowledge possessed by a person that influences the interpretation and usefulness of explanations."@en ;
           rdfs:label "Knowledge"@en .


:KnowledgeLevel rdfs:comment "An ordinal scale used to characterise the level of stakeholder knowledge."@en ;
                rdfs:label "KnowledgeLevel"@en .


:MLDomain rdfs:comment "A domain concerning machine learning, about which technical knowledge is held."@en ;
          rdfs:label "MLDomain"@en .


:ModalityAccess rdfs:comment "A relator expressing that a stakeholder can work with or make use of a particular explanation modality."@en ;
                rdfs:label "ModalityAccess"@en .


:OperationalUser rdfs:comment "A stakeholder who uses the outputs of an AI system during operational decision making."@en ;
                 rdfs:label "OperationalUser"@en .


:OrganisationalComplianceOverseer rdfs:comment "A stakeholder responsible for governance, compliance, auditing, or regulatory oversight of AI systems."@en ;
                                  rdfs:label "OrganisationalComplianceOverseer"@en .


:Person rdfs:comment "A human being who may take on stakeholder roles and who possesses knowledge and sensory abilities."@en ;
        rdfs:label "Person"@en .


:PresentationDimension rdfs:comment "The explanation quality dimension concerning the presentation and representation of explanations."@en ;
                       rdfs:label "PresentationDimension"@en .


:RationaleExplanation rdfs:comment "An explanation stating the reasons that led to an AI-supported decision, expressed in an accessible and understandable way."@en ;
                      rdfs:label "RationaleExplanation"@en .


:RepresentationFormat rdfs:comment "An enumeration of the formats in which an explanation can be represented: textual, visual, numerical, or example-based."@en ;
                      rdfs:label "RepresentationFormat"@en .


:ResearcherTheorist rdfs:comment "A stakeholder interested in advancing scientific understanding of AI, XAI, or explanatory phenomena."@en ;
                    rdfs:label "ResearcherTheorist"@en .


:ResponsibilityExplanation rdfs:comment "An explanation identifying who is involved in developing, managing, and operating an AI system, and whom to contact for human review of a decision."@en ;
                           rdfs:label "ResponsibilityExplanation"@en .


:SafetyAndPerformanceExplanation rdfs:comment "An explanation describing the steps taken to maximise the accuracy, reliability, security, and safety of the outputs and behaviour of an AI system."@en ;
                                 rdfs:label "SafetyAndPerformanceExplanation"@en .


:ScientificExplanation rdfs:comment "An explanation that supports a conclusion by referring to the results of the scientific method, such as findings from rigorous, peer-reviewed studies."@en ;
                       rdfs:label "ScientificExplanation"@en .


:SensoryAbility rdfs:comment "A capacity of a person to perceive information through a sense, such as vision or hearing, which determines the explanation modalities the person can make use of."@en ;
                rdfs:label "SensoryAbility"@en .


:SimulationBasedExplanation rdfs:comment "An explanation that relies on an imitation of a system or process and on the results that emerge from running it on similar inputs."@en ;
                            rdfs:label "SimulationBasedExplanation"@en .


:StatisticalExplanation rdfs:comment "An explanation that conveys statistical or probabilistic evidence, such as the uncertainty or likelihood associated with an output."@en ;
                        rdfs:label "StatisticalExplanation"@en .


:TechnicalCreator rdfs:comment "A stakeholder responsible for developing, maintaining, or validating AI or XAI systems."@en ;
                  rdfs:label "TechnicalCreator"@en .


:TechnicalKnowledge rdfs:comment "Knowledge concerning AI, machine learning, data science, or explainable AI techniques."@en ;
                    rdfs:label "TechnicalKnowledge"@en .


:TraceBasedExplanation rdfs:comment "An explanation that presents the sequence of steps, including data sources and logic, by which a system arrived at a specific result."@en ;
                       rdfs:label "TraceBasedExplanation"@en .


:UserDimension rdfs:comment "The explanation quality dimension concerning stakeholder interaction and interpretation."@en ;
               rdfs:label "UserDimension"@en .


:VisualAcuity rdfs:comment "A sensory ability concerning the sharpness and clarity of a person's vision."@en ;
              rdfs:label "VisualAcuity"@en .


:XAIStakeholder rdfs:comment "A person who interacts with, consumes, develops, governs, evaluates, or is affected by explanations generated by an XAI system."@en ;
                rdfs:label "XAIStakeholder"@en .


:canProcess rdfs:comment "Relates an XAI stakeholder to an explanation modality that the stakeholder is able to work with or make use of."@en ;
            rdfs:label "canProcess"@en .


:contributesTo rdfs:comment "Relates an explanation evaluation metric to the desideratum that it helps to assess."@en ;
               rdfs:label "contributesTo"@en .


:preferredExplanationGoalOf rdfs:comment "Relates an XAI stakeholder to an explanation goal that the stakeholder prefers."@en ;
                            rdfs:label "preferredExplanationGoalOf"@en .


:preferredExplanationModalityOf rdfs:comment "Relates an XAI stakeholder to an explanation modality that the stakeholder prefers."@en ;
                                rdfs:label "preferredExplanationModalityOf"@en .


:preferredExplanationQualityOf rdfs:comment "Relates an explanation quality criterion to an XAI stakeholder who prefers it."@en ;
                               rdfs:label "preferredExplanationQualityOf"@en .


:preferredExplanationTypeOf rdfs:comment "Relates an XAI stakeholder to an explanation type that the stakeholder prefers."@en ;
                            rdfs:label "preferredExplanationTypeOf"@en .


:supportsAchievementOf rdfs:comment "Relates an explanation type to an explanation goal whose achievement it supports."@en ;
                       rdfs:label "supportsAchievementOf"@en .


EPO:Condition rdfs:comment "A situation under which an explanation holds, specifying the circumstances in which an explanans accounts for an explanandum."@en ;
              rdfs:label "Condition"@en .


EPO:Explanandum rdfs:comment "The outcome or phenomenon to be explained, such as a prediction or decision of an ML model."@en ;
                rdfs:label "Explanandum"@en .


EPO:Explanans rdfs:comment "That which does the explaining, namely the reasons or factors that account for an explanandum."@en ;
              rdfs:label "Explanans"@en .


EPO:Explanation rdfs:comment "A relator representing an explanatory relationship between an explanans and an explanandum."@en ;
                rdfs:label "Explanation"@en .


