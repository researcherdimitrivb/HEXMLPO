:DomainKnowledge rdfs:subClassOf :Knowledge.
:MLDomain rdfs:subClassOf :Domain.
:evaluationContext rdfs:domain :ExplanationEvaluationMetric;
    rdfs:range :ContextualityLevel;
    rdf:type owl:ObjectProperty;
    rdfs:subPropertyOf gufo:hasReifiedQualityValue;
    rdfs:label "evaluationContext"@en.
:desideratumName rdfs:domain :Desideratum;
    rdfs:range xsd:string;
    rdf:type owl:DatatypeProperty;
    rdfs:subPropertyOf gufo:hasQualityValue;
    rdfs:label "desideratumName"@en.
:dimension rdfs:domain :Desideratum;
    rdf:type owl:DatatypeProperty;
    rdfs:subPropertyOf gufo:hasQualityValue;
    rdfs:label "dimension"@en.
:format rdfs:domain XMLPO:ExplanationModality>;
    rdfs:range XMLPO:RepresentationFormat>;
    rdf:type owl:ObjectProperty;
    rdfs:subPropertyOf gufo:hasReifiedQualityValue;
    rdfs:label "format"@en.
:status rdfs:domain :SensoryAbility;
    rdfs:range :FunctionalStatus;
    rdf:type owl:ObjectProperty;
    rdfs:subPropertyOf gufo:hasReifiedQualityValue;
    rdfs:label "status"@en.
:rank_2 rdfs:domain :ExplanationGoalPriority;
    rdf:type owl:DatatypeProperty;
    rdfs:subPropertyOf gufo:hasQualityValue;
    rdfs:label "rank"@en.
:rank_1 rdfs:domain :ExplanationTypePriority;
    rdf:type owl:DatatypeProperty;
    rdfs:subPropertyOf gufo:hasQualityValue;
    rdfs:label "rank"@en.
:rank rdfs:domain :ExplanationQualityPriority;
    rdf:type owl:DatatypeProperty;
    rdfs:subPropertyOf gufo:hasQualityValue;
    rdfs:label "rank"@en.
:evidenceSource rdfs:domain :GoalTypeAlignment;
    rdfs:range xsd:string;
    rdf:type owl:DatatypeProperty;
    rdfs:subPropertyOf gufo:hasQualityValue;
    rdfs:label "evidenceSource"@en.
:level rdfs:domain :Knowledge;
    rdfs:range :KnowledgeLevel;
    rdf:type owl:ObjectProperty;
    rdfs:subPropertyOf gufo:hasReifiedQualityValue;
    rdfs:label "level"@en.
:usesMetric rdf:type owl:ObjectProperty;
    rdfs:domain :ExplanationEvaluationExecution;
    rdfs:range :ExplanationEvaluationMetric;
    rdfs:label "usesMetric"@en.
:applicableTo rdf:type owl:ObjectProperty;
    rdfs:domain :ExplanationEvaluationMetric;
    rdfs:range :ExplanationQuality;
    rdfs:label "applicableTo"@en.
:producing rdf:type owl:ObjectProperty;
    rdfs:domain :ExplanationEvaluationExecution;
    rdfs:range :ExplanationQualityMeasurement;
    rdfs:label "producing"@en.
:contributesTo rdf:type owl:ObjectProperty;
    rdfs:domain :ExplanationEvaluationMetric;
    rdfs:range :Desideratum;
    rdfs:label "contributesTo"@en;
    rdf:type gufo:MaterialRelationshipType.
EPO:Explanation gufo:categorizes :ExplanationType.
EPO:expresses rdf:type owl:ObjectProperty;
    rdfs:domain EPO:Explanation>;
    rdfs:range XMLPO:ExplanationArtifact>;
    rdfs:label "expresses"@en.
